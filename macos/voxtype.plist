<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install with __HOME__ replaced by your home directory (launchd does not expand ~). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.voxtype</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/voxtype</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/voxtype.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/voxtype.log</string>
</dict>
</plist>
